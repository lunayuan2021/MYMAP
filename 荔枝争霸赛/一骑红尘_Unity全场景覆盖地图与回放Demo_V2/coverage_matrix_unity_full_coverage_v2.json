{
  "coverageVersion": "2.0",
  "goal": "覆盖游戏设计中 UI 需要渲染的全部固定场景与动态场景",
  "staticCoverage": [
    "80x60 map.data",
    "terrain/object/weather layers",
    "15 nodes",
    "17 edges",
    "routePaths for all edges",
    "ROAD/WATER/MOUNTAIN/BRANCH routes",
    "assetMapping for tiles/nodes/routes/effects"
  ],
  "dynamicCoverage": [
    {
      "scene": "路线移动",
